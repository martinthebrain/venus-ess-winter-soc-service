# Optional deployment-local overrides for venus-ess-winter-soc-service.
# Copy only the values that differ from the defaults into config.env.
# The runit service sources config.env before starting the binary.

# Runtime cadence and boundaries
# ESS_LOOP_INTERVAL_SECONDS=60
# ESS_DBUS_TIMEOUT_SECONDS=2
# ESS_STATUS_LOG_INTERVAL_SECONDS=300
# ESS_INVALID_LOG_INTERVAL_SECONDS=300
# ESS_BATTERY_MAX_CURRENT_MAX_AGE_SECONDS=300
# A live nominal-power observation is cached only for this bounded period.
# ESS_NOMINAL_INVERTER_POWER_MAX_AGE_SECONDS=86400
# Optional installation-bound fallback used only when no fresh live/cache value exists.
# ESS_NOMINAL_INVERTER_POWER_W=none

# Seasonal state persistence to removable SD or USB storage
# ESS_SD_SAVE_INTERVAL_SECONDS=21600
# ESS_SD_LOOKUP_INTERVAL_SECONDS=3600
# ESS_SD_BACKOFF_MAX_SECONDS=300
# Used only for temporary GUI restore state when no removable medium is mounted.
# ESS_DURABLE_RESTORE_FILE=/data/venus-ess-winter-soc-service-rust/gui-restore-state.json

# Diagnostic modes (normally omitted in production)
# ESS_SHADOW_MODE=0
# ESS_ONESHOT=0
# ESS_DECISION_FILE=/dev/shm/venus-ess-winter-soc-service/decision-shadow.json

# Seasonal SoC policy
# ESS_SUMMER_MIN_SOC=10
# ESS_TRANSITION_GUARD_SOC=40
# ESS_WINTER_TARGET_SOC=45
# ESS_BALANCING_TARGET_SOC=100
# ESS_SOC_HYSTERESIS=1
# ESS_MIN_SOC_EPSILON=0.1
# ESS_BOOT_RECOVERY_TARGET_MATCH_EPSILON=0.1
# ESS_BOOT_RECOVERY_SECONDS=600
# ESS_SUMMER_MANUAL_MINSOC_HOLD_SECONDS=86400
# ESS_MIN_SOC_SCRIPT_WRITE_MATCH_SECONDS=180

# Upper charge ceiling (calendar days, reset after GX reboot)
# ESS_ROUTINE_MAX_CHARGE_SOC=90
# ESS_FULL_MAX_CHARGE_SOC=100
# ESS_FULL_CHARGE_REACHED_SOC=99
# ESS_FULL_CHARGE_CONFIRM_SECONDS=7200
# ESS_FULL_CHARGE_MAX_SAMPLE_GAP_SECONDS=90
# ESS_FULL_CHARGE_MIN_AGE_DAYS=2
# ESS_CHARGE_CEILING_CURRENT_EPSILON_A=0.1

# Low-SoC discharge-power protection
# ESS_DISCHARGE_PROTECTION_ENTER_SOC=20
# ESS_DISCHARGE_PROTECTION_RELEASE_SOC=25
# ESS_DISCHARGE_PROTECTION_NOMINAL_FRACTION=0.4
# ESS_DISCHARGE_POWER_EPSILON_W=1
# ESS_DISCHARGE_RECHARGE_MIN_POWER_W=100
# ESS_DISCHARGE_RECHARGE_CONFIRM_SECONDS=120
# ESS_DISCHARGE_RECHARGE_MAX_SAMPLE_GAP_SECONDS=90

# Seasonal dates in MMDD form
# ESS_WINTER_START_MMDD=1125
# ESS_WINTER_END_MMDD=0205
# ESS_TRANSITION_PRE_START_MMDD=1105
# ESS_TRANSITION_PRE_END_MMDD=1124
# ESS_TRANSITION_POST_START_MMDD=0206
# ESS_TRANSITION_POST_END_MMDD=0225

# PV transition policy
# ESS_PV_THRESHOLD_W=3000
# ESS_TRANSITION_DAYS=4
# ESS_PV_MIN_DAILY_COVERAGE_FRACTION=0.75

# Reserve-charging window
# ESS_CHARGE_WINDOW_START_HOUR=23
# ESS_CHARGE_WINDOW_BASE_HOURS=4
# ESS_CHARGE_WINDOW_ESCALATION_NIGHTS=2
# ESS_CHARGE_WINDOW_MAX_MULTIPLIER=4

# Grid and charge-current policy
# ESS_GRID_LOAD_LIMIT_W=4000
# ESS_GRID_PAUSE_HEADROOM_W=100
# ESS_GRID_SOFT_MIN_CHARGE_CURRENT_A=10
# ESS_CHARGE_EFFICIENCY=0.9
# ESS_GRID_CHARGE_MAX_FRACTION=0.4
# ESS_CHARGE_LIMIT_UPDATE_THRESHOLD_A=1
# ESS_CHARGE_LIMIT_MIN_UPDATE_INTERVAL_SECONDS=300
# ESS_SAFE_CHARGE_CURRENT_A=50
# ESS_NORMAL_CHARGE_CURRENT_A=none

# Balancing policy
# ESS_BALANCING_INTERVAL_DAYS=14
# ESS_BALANCING_DURATION_HOURS=4
# Maximum time to reach the high-SoC threshold before retry cooldown begins.
# ESS_BALANCING_APPROACH_MAX_HOURS=72
# Maximum high-SoC phase duration; starts only after the threshold is reached.
# ESS_BALANCING_MAX_HOURS=12
# ESS_BALANCING_RETRY_COOLDOWN_HOURS=24
# ESS_BALANCING_BOOT_GRACE_HOURS=24
# ESS_BALANCING_FULL_SOC=99
# ESS_FULL_SOC_CONFIRM_MINUTES=10

# Boundary selection and paths (normally unchanged)
# ESS_SERVICE_SETTINGS=com.victronenergy.settings
# ESS_SERVICE_SYSTEM=com.victronenergy.system
# Optional fallback for old installations without systemcalc /ActiveBmsService.
# It is never preferred over the active BMS selected by Venus OS.
# ESS_PREFERRED_BATTERY_SERVICE=com.victronenergy.battery.socketcan_can1
# ESS_RUNTIME_DIR=/dev/shm/venus-ess-winter-soc-service
# ESS_INSTANCE_LOCK_FILE=/dev/shm/venus-ess-winter-soc-service/active.lock
# ESS_STATE_FILE=/dev/shm/venus-ess-winter-soc-service/state.json
# ESS_LOG_FILE=/dev/shm/venus-ess-winter-soc-service/log.txt
# Stable identity normally read from /etc/machine-id or /var/lib/dbus/machine-id.
# ESS_STATE_DEVICE_ID=
# Exact mounted removable root; subdirectories and stale mountpoint paths are rejected.
# ESS_SD_PATH=/run/media/mmcblk0p1
# ESS_SD_LABEL=

# Service-script location overrides (normally unchanged)
# ESS_WINTER_RUST_ROOT=/data/venus-ess-winter-soc-service-rust
# ESS_WINTER_RUST_CONFIG=/data/venus-ess-winter-soc-service-rust/config.env
