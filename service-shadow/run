#!/bin/sh
set -eu

ROOT=${ESS_WINTER_RUST_ROOT:-/data/venus-ess-winter-soc-service-rust}
CONFIG=${ESS_WINTER_RUST_CONFIG:-$ROOT/config.env}
if [ -r "$CONFIG" ]; then
    set -a
    . "$CONFIG"
    set +a
fi
export ESS_SHADOW_MODE=1
RUNTIME_DIR=${ESS_RUNTIME_DIR:-/dev/shm/venus-ess-winter-soc-service}
export ESS_RUNTIME_DIR=$RUNTIME_DIR
export ESS_DECISION_FILE=${ESS_DECISION_FILE:-$RUNTIME_DIR/decision-shadow.json}
exec 2>&1
exec "$ROOT/bin/venus-ess-winter-soc-service"
